# Copy to .env.prod on the server and fill in. Used by docker-compose.yml in this folder.

# Postgres password (the db container and the API both read this)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Public URL of the app — must be HTTPS, the session cookie is Secure in production
FRONTEND_URL=https://crm-dev.example.com

# Comma-separated list of emails allowed to sign up or log in. Empty = nobody can log in.
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Google OAuth (optional). Leave blank to disable "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://crm-dev.example.com/api/auth/google/callback
