DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm_dev
PORT=4000
FRONTEND_URL=http://localhost:5173

# Session cookie signing secret — set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated list of email addresses allowed to sign up or log in.
# Required for both email/password and Google sign-in — if empty, nobody can log in.
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Google OAuth (optional). Leave blank to disable the "Continue with Google" button.
# See README.md > Authentication for how to obtain these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
